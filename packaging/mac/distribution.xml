<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Spectra @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="11.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"><line choice="com.shreyas.spectra.vst3"/></line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.shreyas.spectra.vst3" visible="false">
        <pkg-ref id="com.shreyas.spectra.vst3"/>
    </choice>
    <pkg-ref id="com.shreyas.spectra.vst3" version="@VERSION@" onConclusion="none">Spectra.pkg</pkg-ref>
</installer-gui-script>
